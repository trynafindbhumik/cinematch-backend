# Environment: development or production
ENVIRONMENT=development
ALLOWED_ORIGINS=

# Server port
PORT=8080

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# DATABASE
DATABASE_URL=postgres://user:password@localhost:5432/cinematch?sslmode=require

# JWT Signing Key
JWT_SIGNING_KEY=dev-secret-key-change-in-production

# JWT Access Token Expiry (minutes)
ACCESS_TOKEN_EXPIRY_MINUTES=15

# JWT Refresh Token Expiry (days)
REFRESH_TOKEN_EXPIRY_DAYS=30

# OTP Settings
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
RESEND_COOLDOWN_SECONDS=60

# Verification Token Expiry (minutes)
VERIFICATION_TOKEN_EXPIRY_MINUTES=60

# Account Lockout Settings
LOCKOUT_DURATION_MINUTES=15
MAX_LOGIN_ATTEMPTS=5

# Log Level: debug, info, warn, error
# - debug: Shows detailed debug info (development only)
# - info:  Normal operation logs (production default)
# - warn:  Only warnings and errors
# - error: Only errors
LOG_LEVEL=debug

# REDIS
REDIS_URL=redis://localhost:6379

# TMDB API (The Movie Database)
TMDB_API_KEY=your_tmdb_api_key_here

# Gemini API (AI-powered suggestions)
GEMINI_API_KEY=your_gemini_api_key_here

# CLOUDINARY
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# EMAIL (Resend)
# Get API key at https://resend.com/api-keys
# FROM domain must be verified at https://resend.com/domains
# (use onboarding@resend.dev for dev/testing without verification)
EMAIL_ENABLED=true
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM_ADDRESS=onboarding@resend.dev
EMAIL_FROM_NAME=CineMatch