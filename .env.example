# Environment (development | production)
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql://postgres:password@host:5432/database?sslmode=require

# Server
PORT=8080
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# JWT (REQUIRED in production - generate with: openssl rand -base64 32)
JWT_SIGNING_KEY=your-jwt-signing-key-change-in-production

# Auth Settings
ACCESS_TOKEN_EXPIRY_MINUTES=15
REFRESH_TOKEN_EXPIRY_DAYS=7
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
VERIFICATION_TOKEN_EXPIRY_MINUTES=60
LOCKOUT_DURATION_MINUTES=15
MAX_LOGIN_ATTEMPTS=5

# Email (Gmail SMTP with App Password)
EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM_ADDRESS=your-email@gmail.com
EMAIL_FROM_NAME=CineMatch
